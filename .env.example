# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT=

# ── BigQuery Translation API ───────────────────────────────────────────────────
# Region for the BigQuery Migration translateQuery API
BQ_TRANSLATION_LOCATION=asia-south1

# ── Gemini / Vertex AI ────────────────────────────────────────────────────────
# Region for Vertex AI (Gemini) calls — must be a region where Gemini is available
GEMINI_LOCATION=asia-south1
# Model ID used for schema matching (Step 3)
GEMINI_MODEL=gemini-2.5-flash

# ── Flask server ──────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# ── App limits ────────────────────────────────────────────────────────────────
# Max upload size in MB
MAX_UPLOAD_MB=50
# Parallel threads for bulk Excel translation
MAX_WORKERS=10

# ── App limits ────────────────────────────────────────────────────────────────
# Max upload size in MB
MAX_UPLOAD_MB=50
# Parallel threads for bulk Excel translation
MAX_WORKERS=10
